Vaus <- 3 * 10 ^ 8
taus <- function ( length ) {
length / Vaus
}
taus( 1000 )
taus( 3000000 )
taus( 2000 )
taus <- function ( length ) {
value <- length / Vaus
sprintf( "%.10f", value )
}
View(taus)
edit(taus)
View(taus)
taus (1000)
edit(taus)
